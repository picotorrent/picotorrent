<?xml version="1.0" encoding="utf-8"?>

<?if $(var.Platform) = "x64" ?>
    <?define UpgradeCode = "e8ab3252-b12e-4fca-b4c0-ff723283e7dc" ?>
<?else ?>
    <?define UpgradeCode = "2611493f-f5d7-4c5d-934a-623c9a7c7b36" ?>
<?endif ?>

<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

    <Package ProductCode="*"
        UpgradeCode="$(var.UpgradeCode)"
        Name="PicoTorrent"
        Manufacturer="PicoTorrent contributors"
        Language="1033"
        Version="$(var.Version)"
        Scope="perMachine"
        InstallerVersion="301">

        <SummaryInformation Description="PicoTorrent installer" />

        <MajorUpgrade DowngradeErrorMessage="A later version of [ProductName] is already installed. Setup will now exit." />

        <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
        <Icon Id="I_PicoTorrent.ico" SourceFile="$(var.ResourceDirectory)\app.ico" />

        <!-- Schedules before InstallValidate automatically (WiX v4+). -->
        <util:CloseApplication Id="CloseApp"
                               Target="PicoTorrent.exe"
                               RebootPrompt="no"
                               EndSessionMessage="yes" />

        <Feature Id="F_Complete"
                 Title="PicoTorrent"
                 AllowAbsent="no"
                 ConfigurableDirectory="INSTALLDIR"
                 Display="expand"
                 Level="1">

            <ComponentGroupRef Id="CG_MainApplication" />

            <Feature Id="F_Firewall"
                     AllowAbsent="yes"
                     Level="1">
                <Level Condition="SKIP_FIREWALL_EXCEPTION = 1" Value="0" />
                <ComponentGroupRef Id="CG_FirewallException" />
            </Feature>

            <Feature Id="F_Handlers"
                     AllowAbsent="yes"
                     Level="1">
                <Level Condition="SKIP_ASSOCIATE_FILES = 1" Value="0" />
                <ComponentGroupRef Id="CG_Associations" />
            </Feature>
        </Feature>

        <Property Id="ARPPRODUCTICON" Value="I_PicoTorrent.ico" />
    </Package>
</Wix>
